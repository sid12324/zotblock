# Copy to .env.local. The sample-data flow works without credentials.
APP_URL=http://localhost:3000

# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Google Cloud -> OAuth web client. Enable Gmail API and Google Calendar API.
# Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Personal local prototype: your own Canvas token, stored only on the server.
# Do not configure this token on a deployment shared with other users.
CANVAS_BASE_URL=https://canvas.eee.uci.edu
CANVAS_ACCESS_TOKEN=

# Alternative for multiple users: an institutional Canvas OAuth developer key.
# Leave CANVAS_ACCESS_TOKEN empty when using OAuth.
# Redirect URI: http://localhost:3000/api/auth/canvas/callback
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=

# LangChain semantic task extraction. No model call is made in sample mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
